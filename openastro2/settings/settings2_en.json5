  // settings_svg — SVG rendering parameters (consumed in openastro2/openastro2.py:482 and renderer.py:713+).
  "settings_svg": {
    "c1": 0, // inner radius trimming zodiac bands (renderer.py:713, 734).
    "c2": 20, // offset for sign labels (renderer.py:79 — dropin = c2 / 2).
    "c3": 60, // offset for the houses grid (renderer.py:118).
    "r": 237, // overall radius used in SVG templates.
    "roff": 5, // distance between the outer rim and Radix house lines (renderer.py:123).
    "t_roff": 15, // same offset for transit houses (renderer.py:123).
    "roff_deg": 15, // degree label shift for Radix (renderer.py:188).
    "t_roff_deg": 25, // degree label shift for transits (renderer.py:171).
    "circleX": 0, // global X translation of the wheel (renderer.py:770, openastro2-svg.xml).
    "circleY": 0, // global Y translation.
    "offset_degree_planet_x": 4, // tweak for degree text X position (renderer.py:165, 211).
    "offset_degree_planet_y": -4, // tweak for degree text Y position.
    "t_rplanet": 20, // radius for transit planet labels (renderer.py:494).
    "screen_width": 1920, // viewport width for scaling (openastro2.py:482).
    "screen_height": 1152, // viewport height (openastro2.py:483).
    "zoom": 2, // SVG zoom factor (openastro2.py:560 sets self.zoom).
    "printChartType": 1, // 0/1 — render chart type label (renderer.py:792).
    "printDescriptionRadix": 1, // 0/1 — show Radix description block (renderer.py:796).
    "printDescriptionDouble": 1, // 0/1 — show secondary description for transits (renderer.py:824).
    "printAspectGrid": 1, // 0/1 — include the aspect grid (renderer.py:746-765).
    "printElements": 1, // 0/1 — include the elements block (makeElements(); enabled in template).
    "printPlanetGrid": 1, // 0/1 — output Radix planet table (renderer.py:941).
    "printPlanetGrid_t": 1, // 0/1 — output transit planet table (renderer.py:951).
    "printHousesGrid": 1, // 0/1 — output Radix houses grid (renderer.py:945).
    "printHousesGrid_t": 1, // 0/1 — output transit houses grid (renderer.py:954).
    "saveSwgFile": 1, // 0/1 — save SVG file to disk (renderer.py:956).
    "planet_drange": 6, // minimal spacing between planets, used when grouping (renderer.py:562, 623).
    "planet_symbol_scale": 0.6, // Radix planet symbol scale (openastro2_makePlanets_block.txt:116).
    "t_planet_symbol_scale_1": 0.6, // first-row transit symbol scale (openastro2_makePlanets_block.txt:90).
    "t_planet_symbol_scale_2": 0.6 // second-row transit symbol scale (openastro2_makePlanets_block.txt:177).
  }
}
