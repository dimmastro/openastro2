  "settings_planet": [
    // Each object describes a body/point. Fields:
    //   id — numeric identifier (used in planet arrays and color lookups).
    //   name/label/label_short — captions for tables/SVG.
    //   color — fallback stroke color (currently overridden by color_codes.planet_all).
    //   visible — 0/1, whether the body is shown in the wheel (openastro2.py:1489).
    //   element_points — weights for element statistics (renderer.py:1462).
    //   zodiac_relation — managed signs string (shown in the UI).
    //   visible_aspect_line/visible_aspect_grid — participation in aspect drawing and grids.
    //   visible_json — 0/1, whether the object appears in exports.
    // planet_orb holds orbs per chart type (Radix/Transit/SecondaryProgression/Direction, openastro2.py:1550) with keys default/aspect-id (aspect ids match settings_aspect, value is degrees).
    // visible2 temporarily hides the object in the second transit wheel.
    // Custom calculation types are allowed (e.g., "Zemletochki" from main10_zemletochki.py).
