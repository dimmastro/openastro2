    "zodiac_icon_8": "#333333",
    "zodiac_icon_9": "#333333",
    "zodiac_icon_10": "#333333",
    "zodiac_icon_11": "#333333",
    // zodiac_radix_ring_0..2 — colors of the concentric rings of the radix wheel (renderer.py:755-763).
    "zodiac_radix_ring_0": "#CCCCCC",
    "zodiac_radix_ring_1": "#CCCCCC",
    "zodiac_radix_ring_2": "#CCCCCC",
    // zodiac_transit_ring_0..2 — colors of the transit wheel circles (renderer.py:736-744).
    "zodiac_transit_ring_0": "#CCCCCC",
    "zodiac_transit_ring_1": "#CCCCCC",
    "zodiac_transit_ring_2": "#CCCCCC",
    "houses_radix_line": "#444444", // Radix house line color (renderer.py:149).
    "houses_transit_line_1": "#ff0000", // first transit house grid color (renderer.py:151).
    "houses_transit_line_2": "#0000ff", // second transit house grid color (renderer.py:168).
    "planet_all": "#444444", // fallback color for every planet in renderer.py:918 when building TD.
    "color_radix": "#444444", // main color of Radix aspect lines (renderer.py:343).
    "color_transit_1": "#ff0000", // aspect color for the primary transit layer (renderer.py:317).
    "color_transit_2": "#0000FF", // aspect color for the secondary transit layer (renderer.py:264).
    // planet_0..34 — per-body colors (currently unused; TD code remains commented in renderer.py:919).
    "planet_0": "#444444",
    "planet_1": "#444444",
    "planet_2": "#444444",
    "planet_3": "#444444",
    "planet_4": "#444444",
    "planet_5": "#444444",
    "planet_6": "#444444",
    "planet_7": "#444444",
    "planet_8": "#444444",
    "planet_9": "#444444",
    "planet_10": "#444444",
    "planet_11": "#444444",
    "planet_12": "#444444",
    "planet_13": "#444444",
    "planet_14": "#444444",
    "planet_15": "#444444",
    "planet_16": "#000000",
    "planet_17": "#000000",
    "planet_18": "#000000",
    "planet_19": "#000000",
    "planet_20": "#000000",
    "planet_21": "#000000",
    "planet_22": "#444444",
    "planet_23": "#444444",
    "planet_24": "#444444",
    "planet_25": "#444444",
    "planet_26": "#444444",
    "planet_27": "#444444",
    "planet_28": "#000000",
    "planet_29": "#000000",
    "planet_30": "#000000",
    "planet_31": "#000000",
    "planet_32": "#000000",
    "planet_33": "#000000",
    "planet_34": "#000000",
    // lunar_phase_0..2 — colors for the lunar phase indicator in the description block (renderer.py:904).
    "lunar_phase_0": "#000000",
    "lunar_phase_1": "#FFFFFF",
    "lunar_phase_2": "#CCCCCC"
  },
  // label — dictionary of captions injected by renderer.py when building textual blocks (directions, table headers, etc.).
  "label": {
    "cusp": "Cusp", // houses caption (renderer.py:1517; currently commented but kept for reuse).
    "longitude": "Lon", // used when printing event data (renderer.py:833).
    "latitude": "Lat", // likewise for latitude (renderer.py:832).
    "north": "N", // indicator for north on the map (renderer.py:43).
    "east": "E", // indicator for east (renderer.py:53).
    "south": "S", // indicator for south, shown for negative latitudes (renderer.py:45).
    "west": "W", // indicator for west (renderer.py:55).
    "apparent_geocentric": "Apparent Geocentric", // label for postype='geo' (renderer.py:817).
    "true_geocentric": "True Geocentric", // label for postype='truegeo'.
    "topocentric": "Topocentric", // label for postype='topo'.
    "heliocentric": "Heliocentric", // label for postype='helio'.
    "fire": "Fire", // title for the Fire element block (renderer.py:1463).
    "earth": "Earth", // Earth element block (renderer.py:1464).
    "air": "Air", // Air element block (renderer.py:1465).
    "water": "Water", // Water element block (renderer.py:1466).
    "radix": "Radix", // label for the base wheel (used in UI/exports).
    "transit": "Transit", // label for the transit wheel (used in JSON reports).
    "synastry": "Synastry", // label for synastry charts (used in API responses).
    "composite": "Composite", // label for composite charts (used in charts API).
    "combine": "Combine", // label for combined charts (kept for compatibility).
    "solar": "Solar", // label for solar returns.
    "secondary_progressions": "Secondary Progressions" // label for secondary progressions.
  },
  "settings_aspect": [
    // Object fields:
    //   id — string key populating settings_aspect_dic (openastro2.py:210).
    //   degree — exact angular distance between planets in degrees.
    //   name/label/label_short — captions for tables/SVG.
    //   color — used in orb_color_* (renderer.py:928).
    //   visible — 0/1, whether to draw the aspect line (openastro2.py:1545).
    //   visible_grid — 0/1, whether to include the aspect in grids (openastro2.py:1663).
    //   is_major/is_minor — strength markers used in filters (openastro2.py:1353).
    //   orb — maximum orb (openastro2.py:1551).
    //   visible_json — 0/1, whether the aspect appears in JSON/SVG JSON (renderer.py:1334).
    // id and degree values must remain unique.
    // Base aspect “conjunction” — orb=10°.
    {
      "id": "0",
      "degree": 0,
      "name": "conjunction 0",
      "label": "conjunction",
      "label_short": "☌",
      "color": "#4093f4",
      "visible": 1,
      "visible_grid": 1,
      "is_major": 1,
      "is_minor": 0,
      "orb": 10,
      "visible_json": 1
    },
    // Minor aspect vigintil (1/20 of the circle), orb=1°.
    {
      "id": "18",
      "degree": 18,
