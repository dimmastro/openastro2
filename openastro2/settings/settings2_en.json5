{
  // astrocfg — base client settings used by the event builder and renderer (loaded in openastro2/openastro2.py:184 and read throughout the app).
  "astrocfg": {
    // version — schema revision stored for backward compatibility, not read directly in code.
    "version": "2.0.0",
    // home_location — label of the default home city, kept for UI and regression fixtures (not looked up in code, only serialized).
    "home_location": "London",
    // home_geolat — latitude string of the home location; preserved in exported JSON for APIs/tests.
    "home_geolat": "56.01839",
    // home_geolon — longitude string of the home location; stored in snapshots only.
    "home_geolon": "0.0",
    // home_countrycode — ISO country code (only used in regression fixtures, not read elsewhere).
    "home_countrycode": "EN",
    // home_timezonestr — IANA timezone identifier passed to exported events (unused at runtime, acts as default metadata).
    "home_timezonestr": "Asia/Krasnoyarsk",
    // use_geonames.org — '0'/'1' flag intended to toggle the online geonames lookup (not currently honored anywhere).
    "use_geonames.org": "0",
    // houses_system — Swiss Ephemeris house system code (single-letter identifiers such as 'P', 'K', 'E', 'W'); used in swiss.py:259 and local_space.py:503.
    "houses_system": "P",
    // houses_system_polar — fallback system for polar latitudes; allowed values ['A','D','E','H','M','N','O','U','V','W','X'] override houses_system where required (swiss.py:259, 718, 1111).
    "houses_system_polar": "A",
    // postype — position type for planetary calculations; read in swiss.py:146, values: 'geo', 'truegeo', 'topo', 'helio'.
    "postype": "geo",
    // chartview — chart layout style controlling renderer branches ('european' or 'traditional'; the latter defined in settings/settings.json).
    "chartview": "european",
    // zodiactype — 'tropical' or 'sidereal'; sidereal mode triggers ayanamsa handling in renderer.py:861 and swiss.py:154.
    "zodiactype": "tropical",
    // siderealmode — Swiss Ephemeris ayanamsa identifier; swiss.py:156 converts it to 'SIDM_<mode>'. Supported values: FAGAN_BRADLEY, LAHIRI, DELUCE, RAMAN, USHASHASHI, KRISHNAMURTI, DJWHAL_KHUL, YUKTESHWAR, JN_BHASIN, BABYL_KUGLER1, BABYL_KUGLER2, BABYL_KUGLER3, BABYL_HUBER, BABYL_ETPSC, ALDEBARAN_15TAU, HIPPARCHOS, SASSANIAN, J2000, J1900, B1950.
    "siderealmode": "FAGAN_BRADLEY",
    // language — locale code defined in LANGUAGES_LABEL (openastro2/openastro2.py:86); passed to setLanguage().
    "language": "en",
    // round_aspects — 0/1 toggle for rounding in utils.degreeDiff()/degreeDiff2() (openastromod/utils.py:110, openastro2.py:1429).
    "round_aspects": 1,
    // planet_in_one_house — 0/1 flag to allow multiple objects per house in the tables (checked in openastro2.py:1103/1183).
    "planet_in_one_house": 0,
    // geo_zodiac_start — shift of the geographic zodiac in degrees (used in openastromod/local_to.py:736, 769).
    "geo_zodiac_start": 0
  },
  // color_codes — palette consumed by the SVG renderer (openastromod/renderer.py:110, 317, 404, etc.).
  "color_codes": {
    "paper_0": "#000000", // primary text/icon color for Radix (renderer.py:384, 918).
    "paper_1": "#ffffff", // table/background fill, used as the base circle color (renderer.py:736).
    // zodiac_bg_0..11 — background colors for each sign in order, used in makeZodiac (renderer.py:110).
    "zodiac_bg_0": "#ef5350",
    "zodiac_bg_1": "#73b230",
    "zodiac_bg_2": "#ffd237",
    "zodiac_bg_3": "#4093f4",
    "zodiac_bg_4": "#ef5350",
    "zodiac_bg_5": "#73b230",
    "zodiac_bg_6": "#ffd237",
    "zodiac_bg_7": "#4093f4",
    "zodiac_bg_8": "#ef5350",
    "zodiac_bg_9": "#73b230",
    "zodiac_bg_10": "#ffd237",
    "zodiac_bg_11": "#4093f4",
    // zodiac_icon_0..11 — glyph colors for sign labels (renderer.py:922).
    "zodiac_icon_0": "#333333",
    "zodiac_icon_1": "#333333",
    "zodiac_icon_2": "#333333",
    "zodiac_icon_3": "#333333",
    "zodiac_icon_4": "#333333",
