  // settings_svg — параметры отрисовки SVG (подхватываются в openastro2/openastro2.py:482 и renderer.py:713+).
  "settings_svg": {
    "c1": 0, // внутренний радиус, на который режутся полосы зодиака (renderer.py:713, 734).
    "c2": 20, // смещение для подписей знаков (renderer.py:79 — dropin = c2 / 2).
    "c3": 60, // отступ для сетки домов (renderer.py:118).
    "r": 237, // общий радиус круга, используется в svg-шаблонах.
    "roff": 5, // расстояние между внешним краем и линиями домов радикса (renderer.py:123).
    "t_roff": 15, // аналогичный отступ для транзитной сетки (renderer.py:123).
    "roff_deg": 15, // сдвиг подписей градусов для радикса (renderer.py:188).
    "t_roff_deg": 25, // сдвиг подписей для транзитной сетки (renderer.py:171).
    "circleX": 0, // сдвиг всего колеса по оси X (renderer.py:770, шаблон openastro2-svg.xml).
    "circleY": 0, // сдвиг по оси Y.
    "offset_degree_planet_x": 4, // поправка расположения текстовых подписей градусов (renderer.py:165, 211).
    "offset_degree_planet_y": -4, // вертикальная поправка для подписей градусов.
    "t_rplanet": 20, // радиус подписи транзитной планеты (renderer.py:494).
    "screen_width": 1920, // ширина окна, используется для масштабирования в openastro2.py:482.
    "screen_height": 1152, // высота окна (openastro2.py:483).
    "zoom": 2, // множитель увеличения SVG (openastro2.py:560 устанавливает self.zoom).
    "printChartType": 1, // 0/1 — выводить подпись типа карты (renderer.py:792).
    "printDescriptionRadix": 1, // 0/1 — печатать описание радикса (renderer.py:796).
    "printDescriptionDouble": 1, // 0/1 — печатать второй блок описания для транзитной карты (renderer.py:824).
    "printAspectGrid": 1, // 0/1 — добавлять таблицу аспектов (renderer.py:746-765).
    "printElements": 1, // 0/1 — показывать блок элементов (makeElements(); включение/выключение реализуется на уровне шаблона).
    "printPlanetGrid": 1, // 0/1 — вывод таблицы планет радикса (renderer.py:941).
    "printPlanetGrid_t": 1, // 0/1 — таблица транзитных планет (renderer.py:951).
    "printHousesGrid": 1, // 0/1 — таблица домов радикса (renderer.py:945).
    "printHousesGrid_t": 1, // 0/1 — таблица домов транзита (renderer.py:954).
    "saveSwgFile": 1, // 0/1 — сохранять файл SVG на диск (renderer.py:956).
    "planet_drange": 6, // минимальный интервал между планетами в круге, используется при рассчёте групп (renderer.py:562, 623).
    "planet_symbol_scale": 0.6, // масштаб символов радикса (openastro2_makePlanets_block.txt:116).
    "t_planet_symbol_scale_1": 0.6, // масштаб транзитных символов в первом ряду (openastro2_makePlanets_block.txt:90).
    "t_planet_symbol_scale_2": 0.6 // масштаб транзитных символов во втором ряду (openastro2_makePlanets_block.txt:177).
  }
}
