{
  // astrocfg — базовые настройки клиента, которые используются в конструкторе событий и при отрисовке (подгружается в openastro2/openastro2.py:184 и затем читается по всему приложению).
  "astrocfg": {
    // version — номер схемы настроек; хранится для обратной совместимости, прямых обращений в коде нет.
    "version": "2.0.0",
    // home_location — строка с подписью «домашнего» города, хранится для UI и тестовых фикстур (в коде поиска нет, используется косвенно при сериализации данных в tests/tests_regressions).
    "home_location": "London",
    // home_geolat — широта домашней точки как строка; не читается напрямую, но остаётся в выходном JSON для API и регрессий.
    "home_geolat": "56.01839",
    // home_geolon — долгота домашней точки; аналогично широте сохраняется только в снэпшотах.
    "home_geolon": "0.0",
    // home_countrycode — ISO‑код страны (используется только при построении тестовых данных, прямых обращений в коде нет).
    "home_countrycode": "EN",
    // home_timezonestr — идентификатор по IANA, который попадает в экспорт событий (в run‑time чтений нет, поэтому значение служит дефолтом для пользовательских данных).
    "home_timezonestr": "Asia/Krasnoyarsk",
    // use_geonames.org — флаг строкой '0' или '1', планировался для включения online‑поиска городов (поддержка в openastromod/geoname.py пока не подключена, поэтому поле не считывается).
    "use_geonames.org": "0",
    // houses_system — код системы домов Swiss Ephemeris (см. swe.houses), поддерживаются все режимы одной буквой, чаще всего 'P' (Placidus), 'K' (Koch), 'E' (Equal), 'W' (Whole Sign); используется при расчётах домов в openastro2/openastromod/swiss.py:259 и local_space.py:503.
    "houses_system": "P",
    // houses_system_polar — альтернативный код домов для полярных широт; допустимы только ['A','D','E','H','M','N','O','U','V','W','X'] из swiss.houses и при необходимости значение подменяет houses_system (см. swiss.py:259, 718, 1111).
    "houses_system_polar": "A",
    // postype — система координат для расчёта планет; код считывается в swiss.py:146 и может быть 'geo' (аппаратный геоцентр), 'truegeo', 'topo', 'helio'.
    "postype": "geo",
    // chartview — визуальный стиль колеса, переключает ветки отрисовки в renderer.py (варианты 'european' и 'traditional'; второй используется в settings/settings.json).
    "chartview": "european",
    // zodiactype — тип зодиака: 'tropical' (по умолчанию) или 'sidereal'; для сидерического режима renderer.py:861 и swiss.py:154 добавляют айанамсу.
    "zodiactype": "tropical",
    // siderealmode — айанамса Swiss Ephemeris; в swiss.py:156 формируется ключ 'SIDM_<mode>'. Возможные значения: FAGAN_BRADLEY, LAHIRI, DELUCE, RAMAN, USHASHASHI, KRISHNAMURTI, DJWHAL_KHUL, YUKTESHWAR, JN_BHASIN, BABYL_KUGLER1, BABYL_KUGLER2, BABYL_KUGLER3, BABYL_HUBER, BABYL_ETPSC, ALDEBARAN_15TAU, HIPPARCHOS, SASSANIAN, J2000, J1900, B1950.
    "siderealmode": "FAGAN_BRADLEY",
    // language — код локали из словаря LANGUAGES_LABEL в openastro2/openastro2.py:86 (поддерживаются ar, pt_BR, bg, ca, cs, da, nl, eo, en, fi, fr, de, el, hu, it, ja, nds, rom, ru, es, uk, zh_TW); передаётся в setLanguage().
    "language": "en",
    // round_aspects — 0 или 1: включение округления аспектов в utils.degreeDiff/degreeDiff2 (см. openastromod/utils.py:110 и вызовы в openastro2.py:1429).
    "round_aspects": 1,
    // planet_in_one_house — 0 или 1: разрешать нескольким объектам занимать один дом в таблицах домов (проверяется в openastro2.py:1103 и 1183).
    "planet_in_one_house": 0,
    // geo_zodiac_start — сдвиг географического зодиака в градусах (используется при расчётах направлений в openastromod/local_to.py:736, 769).
    "geo_zodiac_start": 0
  },
  // color_codes — палитра, которую читает SVG-рендерер (openastromod/renderer.py:110, 317, 404 и др.).
  "color_codes": {
    "paper_0": "#000000", // основной цвет текста/иконок для Radix (renderer.py:384, 918).
    "paper_1": "#ffffff", // фон и заливка таблиц, используется как базовый цвет окружностей (renderer.py:736).
    // zodiac_bg_0..11 — цвета фона для каждого знака по порядку; применяются в makeZodiac (renderer.py:110).
    "zodiac_bg_0": "#ef5350",
    "zodiac_bg_1": "#73b230",
    "zodiac_bg_2": "#ffd237",
    "zodiac_bg_3": "#4093f4",
    "zodiac_bg_4": "#ef5350",
    "zodiac_bg_5": "#73b230",
    "zodiac_bg_6": "#ffd237",
    "zodiac_bg_7": "#4093f4",
    "zodiac_bg_8": "#ef5350",
    "zodiac_bg_9": "#73b230",
    "zodiac_bg_10": "#ffd237",
    "zodiac_bg_11": "#4093f4",
    // zodiac_icon_0..11 — цвет глифов знаков в подписях (renderer.py:922).
    "zodiac_icon_0": "#333333",
    "zodiac_icon_1": "#333333",
    "zodiac_icon_2": "#333333",
    "zodiac_icon_3": "#333333",
    "zodiac_icon_4": "#333333",
    "zodiac_icon_5": "#333333",
    "zodiac_icon_6": "#333333",
    "zodiac_icon_7": "#333333",
    "zodiac_icon_8": "#333333",
    "zodiac_icon_9": "#333333",
    "zodiac_icon_10": "#333333",
    "zodiac_icon_11": "#333333",
    // zodiac_radix_ring_0..2 — цвета концентрических окружностей основного круга (renderer.py:755-763).
    "zodiac_radix_ring_0": "#CCCCCC",
    "zodiac_radix_ring_1": "#CCCCCC",
    "zodiac_radix_ring_2": "#CCCCCC",
    // zodiac_transit_ring_0..2 — цвета окружностей транзитного колеса (renderer.py:736-744).
    "zodiac_transit_ring_0": "#CCCCCC",
    "zodiac_transit_ring_1": "#CCCCCC",
    "zodiac_transit_ring_2": "#CCCCCC",
    "houses_radix_line": "#444444", // цвет линий домов Radix (renderer.py:149).
    "houses_transit_line_1": "#ff0000", // цвет первой транзитной сетки домов (renderer.py:151).
    "houses_transit_line_2": "#0000ff", // цвет второй транзитной сетки домов (renderer.py:168).
    "planet_all": "#444444", // fallback-цвет для всех планет в renderer.py:918 (линии/символы при построении TD).
    "color_radix": "#444444", // основной цвет аспектных линий Radix (renderer.py:343).
    "color_transit_1": "#ff0000", // цвет аспектов основного транзита (renderer.py:317).
    "color_transit_2": "#0000FF", // цвет аспектов второго транзитного слоя (renderer.py:264).
    // planet_0..34 — индивидуальные цвета для тел (пока не используются, но код для TD оставлен закомментированным в renderer.py:919).
    "planet_0": "#444444",
    "planet_1": "#444444",
    "planet_2": "#444444",
    "planet_3": "#444444",
    "planet_4": "#444444",
    "planet_5": "#444444",
    "planet_6": "#444444",
    "planet_7": "#444444",
    "planet_8": "#444444",
    "planet_9": "#444444",
    "planet_10": "#444444",
    "planet_11": "#444444",
    "planet_12": "#444444",
    "planet_13": "#444444",
    "planet_14": "#444444",
    "planet_15": "#444444",
    "planet_16": "#000000",
    "planet_17": "#000000",
    "planet_18": "#000000",
    "planet_19": "#000000",
    "planet_20": "#000000",
    "planet_21": "#000000",
    "planet_22": "#444444",
    "planet_23": "#444444",
    "planet_24": "#444444",
    "planet_25": "#444444",
    "planet_26": "#444444",
    "planet_27": "#444444",
    "planet_28": "#000000",
    "planet_29": "#000000",
    "planet_30": "#000000",
    "planet_31": "#000000",
    "planet_32": "#000000",
    "planet_33": "#000000",
    "planet_34": "#000000",
    // lunar_phase_0..2 — палитра индикатора фаз Луны в блоке описания (renderer.py:904).
    "lunar_phase_0": "#000000",
    "lunar_phase_1": "#FFFFFF",
    "lunar_phase_2": "#CCCCCC"
  },
  // label — словарь подписей, подставляется в renderer.py при формировании текстовых блоков (например, стрелки направлений на карте и заголовки таблиц).
  "label": {
    "cusp": "Cusp", // подпись домов (renderer.py:1517; строка закомментирована, но оставлена для повторного включения).
    "longitude": "Lon", // используется при выводе данных событий (renderer.py:833).
    "latitude": "Lat", // аналогично широте (renderer.py:832).
    "north": "N", // маркер северной стороны карты (renderer.py:43).
    "east": "E", // маркер востока (renderer.py:53).
    "south": "S", // маркер юга, выводится при отрицательной широте (renderer.py:45).
    "west": "W", // маркер запада (renderer.py:55).
    "apparent_geocentric": "Apparent Geocentric", // подпись режима postype='geo' (renderer.py:817).
    "true_geocentric": "True Geocentric", // подпись для postype='truegeo'.
    "topocentric": "Topocentric", // подпись для postype='topo'.
    "heliocentric": "Heliocentric", // подпись для postype='helio'.
    "fire": "Fire", // заголовок элемента Огонь в блоке стихий (renderer.py:1463).
    "earth": "Earth", // блок Земля (renderer.py:1464).
    "air": "Air", // блок Воздух (renderer.py:1465).
    "water": "Water", // блок Вода (renderer.py:1466).
    "radix": "Radix", // подпись основного круга (используется в UI и экспортируемых JSON, прямых обращений в коде нет).
    "transit": "Transit", // подпись транзитного круга (используется в JSON отчётах).
    "synastry": "Synastry", // ярлык для типа карты «Синастрия» (на текущий момент тип не выводится в renderer, но используется в API ответах).
    "composite": "Composite", // подпись для композитов (используется в данных charts API).
    "combine": "Combine", // подпись комбинированных карт (набор label хранится для совместимости).
    "solar": "Solar", // подпись солнечных возвращений.
    "secondary_progressions": "Secondary Progressions" // подпись вторичных прогрессий.
  },
  "settings_aspect": [
    // Поля объектов:
    //   id — строковый ключ, формирует индекс settings_aspect_dic (openastro2.py:210).
    //   degree — точное расстояние между планетами в градусах.
    //   name/label/label_short — подписи для таблиц и SVG.
    //   color — используется в orb_color_* (renderer.py:928).
    //   visible — 0/1, строим ли аспектную линию (openastro2.py:1545).
    //   visible_grid — 0/1, включаем ли аспект в таблицу сетки (openastro2.py:1663).
    //   is_major/is_minor — маркеры силы аспекта (участвуют в фильтрации openastro2.py:1353).
    //   orb — максимальный орбус (openastro2.py:1551).
    //   visible_json — 0/1, показывать ли аспект в JSON и SVG JSON (renderer.py:1334).
    // Значения id и degree должны быть уникальны.
    // Основной аспект «соединение» — orb=10°.
    {
      "id": "0",
      "degree": 0,
      "name": "conjunction 0",
      "label": "conjunction",
      "label_short": "☌",
      "color": "#4093f4",
      "visible": 1,
      "visible_grid": 1,
      "is_major": 1,
      "is_minor": 0,
      "orb": 10,
      "visible_json": 1
