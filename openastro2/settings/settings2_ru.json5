  "settings_planet": [
    // Каждый объект описывает тело/точку. Поля:
    //   id — числовой идентификатор (используется в массивах планет и при поиске цветов).
    //   name/label/label_short — подписи в таблицах и SVG.
    //   color — fallback для линий (сейчас заменяется color_codes.planet_all).
    //   visible — 0/1, показывать ли тело в круге (openastro2.py:1489).
    //   element_points — баллы для подсчёта стихий (renderer.py:1462).
    //   zodiac_relation — строка управляемых знаков (используется в UI).
    //   visible_aspect_line/visible_aspect_grid — участие в аспектах и таблицах.
    //   visible_json — 0/1, попадёт ли объект в экспорт.
    // Блок planet_orb содержит орбы по типам карт Radix/Transit/SecondaryProgression/Direction (openastro2.py:1550) с ключами default и конкретными аспектами (название совпадает с id из settings_aspect, значение в градусах).
    // Ключ visible2 временно скрывает объект во втором круге транзитов.
    // Допускается добавление пользовательских типов расчёта (например, "Zemletochki" из main10_zemletochki.py).
    {
      "id": 0,
      "name": "sun",
      "color": "#444444",
      "visible": 1,
      "element_points": 40,
      "zodiac_relation": "4",
      "label": "Sun",
